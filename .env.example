# Generate a random owner password with scripts/create-access.mjs.
# Hash and signing key stay on the server; never commit real values.
DASHBOARD_PASSWORD_SHA256=
DASHBOARD_SESSION_SECRET=
APP_ORIGIN=https://your-siteperch.vercel.app
SITE_DOMAIN=example.com

# Google: choose one method. Preferred for a personal dashboard: read-only service account.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Or an existing offline OAuth grant with analytics.readonly + webmasters.readonly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GA4_PROPERTY_ID=
SEARCH_CONSOLE_SITE=

# Cloudflare: account-scoped Account Analytics Read.
CLOUDFLARE_ANALYTICS_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_SITE_TAG=

# Vercel: dedicated token limited to the relevant team/project where supported.
VERCEL_ANALYTICS_TOKEN=
VERCEL_ANALYTICS_PROJECT_ID=
VERCEL_ANALYTICS_TEAM_ID=

# Bing: user-level key; only the fixed BING_SITE is queried by this backend.
BING_WEBMASTER_API_KEY=
BING_SITE=
